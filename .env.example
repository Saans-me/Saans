# ---- Waitlist (server only: never add a NEXT_PUBLIC_ prefix to these) ----
# Project Settings -> Data API -> Project URL, e.g. https://abcd1234.supabase.co
SUPABASE_URL=
# Project Settings -> API Keys -> secret key (sb_secret_...) or the legacy service_role key.
# Bypasses RLS. Without these two the waitlist shows an error to the user and logs why.
SUPABASE_SECRET_KEY=
# Optional. Header holding the real client IP, for rate limiting. Leave empty on Vercel.
# Netlify: x-nf-client-connection-ip
TRUSTED_CLIENT_IP_HEADER=

# Sends the waitlist's confirmation email. Resend -> API Keys, with sending access.
RESEND_API_KEY=
# The sender, on a domain verified in Resend, e.g. SAANS <hello@saans.me>
WAITLIST_FROM_EMAIL=
# Optional. The site address used in the email's link. Defaults to https://saans.me
SITE_URL=

